# ==============================================================================
# Aman Mishra Portfolio - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Client-side)
# ------------------------------------------------------------------------------
# These variables ARE bundled into the frontend client code and visible in the browser.
# DO NOT place private API keys, secrets, or EmailJS private credentials here.

# Cloudflare Turnstile Public Site Key
# Sign up at https://dash.cloudflare.com/ -> Turnstile -> Add Site
# For local testing, you can use Cloudflare's official testing sitekey (Always passes):
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here


# ------------------------------------------------------------------------------
# 2. BACKEND / SERVERLESS ENVIRONMENT VARIABLES (Vercel Serverless / Node.js)
# ------------------------------------------------------------------------------
# These variables MUST remain strictly server-side. Configure them in:
# Vercel Project Dashboard -> Settings -> Environment Variables
# NEVER prefix these with VITE_ to prevent accidental bundle exposure.

# Cloudflare Turnstile Secret Key (Server-side token verification)
# For local testing, you can use Cloudflare's official testing secret (Always passes):
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key_here

# EmailJS Server-side Credentials
# 1. Sign up at https://www.emailjs.com/
# 2. Add Email Service (e.g. Gmail) -> Copy "Service ID"
# 3. Create Email Template -> Copy "Template ID"
# 4. Account -> API Keys -> Copy "Public Key"
# 5. Account -> Security -> Enable API Secret Key / Access Token -> Copy "Private Key"
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_PRIVATE_KEY=your_emailjs_private_access_token_here
