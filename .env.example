# ==============================================================================
# MANTRI HYBRID AI ENGINE CONFIGURATION (.env.example)
# Official Google Gemini API + Self-Hosted Fallback Chain
# ==============================================================================

# Provider API Keys — Keys alone enable the corresponding provider
# Mantri dynamically discovers, evaluates, and selects available models automatically.
# No model names or provider priorities are required.

# Google Gemini API (Enabled when key is present)
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# Groq Cloud API (Enabled when key is present)
# https://console.groq.com/
GROQ_API_KEY=your_groq_api_key

# Optional: Local Ollama Daemon (Defaults to http://localhost:11434 if unset)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# Persistent Storage Paths
VECTOR_DB_PATH=./data/vector_store.json
CHAT_HISTORY_DB_PATH=./data/conversations.sqlite

# Administrative Security Key for Ingestion & Reindexing endpoints
ADMIN_API_KEY=change_me_to_a_secure_random_token_in_production

# Backend Server Listening Port
MANTRI_PORT=3001

# Frontend API Target (Set to your local or deployed Mantri engine endpoint)
# For local development with frontend & backend:
VITE_MANTRI_API_URL=http://localhost:3001/api/chat
# For production serverless proxy:
# MANTRI_BACKEND_URL=https://your-selfhosted-inference-server.example.com

# Contact form: server-side email ownership verification (never prefix secrets with VITE_)
# Apply migrations/001_contact_verification.sql using a dedicated backend table-owner role.
DATABASE_URL=
RESEND_API_KEY=
EMAIL_FROM=
# Existing portfolio inbox; leave unset to retain the existing fallback recipient.
CONTACT_RECEIVER_EMAIL=
CONTACT_SITE_URL=https://calligraphyguruji.dev
CONTACT_RATE_LIMIT_SECRET=
CRON_SECRET=

# Preserve the existing Turnstile widget and server secret.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=calligraphyguruji.dev,www.calligraphyguruji.dev

# Optional contact limits (defaults shown); token validity is fixed at 15 minutes.
CONTACT_MAX_EMAIL_PER_HOUR=3
CONTACT_MAX_IP_PER_HOUR=5
CONTACT_MAX_PENDING_PER_EMAIL=2
CONTACT_RESEND_COOLDOWN_SECONDS=60

# Optional LOCAL TEST database only. Tests create/drop their own isolated schema.
# CONTACT_TEST_DATABASE_URL=postgresql://localhost/portfolio_test
