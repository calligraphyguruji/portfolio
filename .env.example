# ==============================================================================
# MANTRI HYBRID AI ENGINE CONFIGURATION (.env.example)
# Official Google Gemini API + Self-Hosted Fallback Chain
# ==============================================================================

# Official Google Gemini API (Recommended for production reasoning & speed)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash-lite,gemini-1.5-flash,gemini-1.5-pro
GEMINI_MAX_ATTEMPTS=4
GEMINI_COOLDOWN_SECONDS=60
REQUEST_TIMEOUT_MS=12000
AI_PROVIDER=gemini

# Official Groq API Fallback (High-speed fallback provider for Gemini 404 / outage failover)
# Obtain a key from Groq Console: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant
GROQ_MAX_ATTEMPTS=2
GROQ_COOLDOWN_SECONDS=60

# Ollama Local Daemon Base URL (Optional local secondary fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# Persistent Storage Paths
VECTOR_DB_PATH=./data/vector_store.json
CHAT_HISTORY_DB_PATH=./data/conversations.sqlite

# Administrative Security Key for Ingestion & Reindexing endpoints
ADMIN_API_KEY=change_me_to_a_secure_random_token_in_production

# Backend Server Listening Port
MANTRI_PORT=3001

# Frontend API Target (Set to your local or deployed Mantri engine endpoint)
# For local development with frontend & backend:
VITE_MANTRI_API_URL=http://localhost:3001/api/chat
# For production serverless proxy:
# MANTRI_BACKEND_URL=https://your-selfhosted-inference-server.example.com
