# ==============================================================================
# MANTRI HYBRID AI ENGINE CONFIGURATION (.env.example)
# Official Google Gemini API + Self-Hosted Fallback Chain
# ==============================================================================

# Provider API Keys — Keys alone enable the corresponding provider
# Mantri dynamically discovers, evaluates, and selects available models automatically.
# No model names or provider priorities are required.

# Google Gemini API (Enabled when key is present)
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# Groq Cloud API (Enabled when key is present)
# https://console.groq.com/
GROQ_API_KEY=your_groq_api_key

# Optional: Local Ollama Daemon (Defaults to http://localhost:11434 if unset)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# Persistent Storage Paths
VECTOR_DB_PATH=./data/vector_store.json
CHAT_HISTORY_DB_PATH=./data/conversations.sqlite

# Administrative Security Key for Ingestion & Reindexing endpoints
ADMIN_API_KEY=change_me_to_a_secure_random_token_in_production

# Backend Server Listening Port
MANTRI_PORT=3001

# Frontend API Target (Set to your local or deployed Mantri engine endpoint)
# For local development with frontend & backend:
VITE_MANTRI_API_URL=http://localhost:3001/api/chat
# For production serverless proxy:
# MANTRI_BACKEND_URL=https://your-selfhosted-inference-server.example.com

# ==============================================================================
# CONTACT FORM CONFIGURATION
# ==============================================================================

# Primary Provider: Resend (https://resend.com)
RESEND_API_KEY=your_resend_api_key
# Verified sender email on Resend (e.g. Aman Mishra Portfolio <contact@calligraphyguruji.dev> or onboarding@resend.dev)
EMAIL_FROM=Aman Mishra Portfolio <contact@calligraphyguruji.dev>
# Portfolio recipient inbox (defaults to amanmishra7774@gmail.com if unset)
CONTACT_RECEIVER_EMAIL=amanmishra7774@gmail.com
CONTACT_SITE_URL=https://calligraphyguruji.dev

# Cloudflare Turnstile Bot Protection (https://dash.cloudflare.com/)
VITE_TURNSTILE_SITE_KEY=your_turnstile_public_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_ALLOWED_HOSTNAMES=calligraphyguruji.dev,www.calligraphyguruji.dev

# Secondary Fallback Provider: EmailJS (Optional)
# EMAILJS_SERVICE_ID=your_emailjs_service_id
# EMAILJS_TEMPLATE_ID=your_emailjs_template_id
# EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Optional Persistent Database (Neon PostgreSQL)
# Configure this in production for rate limits and deduplication shared across Vercel instances.
# Apply migrations/001_contact_verification.sql as the backend owner before deploying.
# Without it, limits exist only in each warm process and reset on cold starts.
# DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
