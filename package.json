{
  "name": "aman-mishra-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "contact:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-contact-config.mjs",
    "build:api": "esbuild server/copilotVercel.ts --bundle --platform=node --format=esm --packages=external --outfile=api/copilot.js",
    "build": "npm run build:api && tsc -b && vite build",
    "preview": "vite preview",
    "server": "node --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test tests/contactApi.test.ts tests/contactRuntime.test.ts tests/architectureExperience.test.ts tests/seoRouting.test.ts tests/copilotRag.test.ts tests/mantriEngine.test.ts tests/geminiProvider.test.ts tests/geminiModelRouter.test.ts tests/intentAndRagFix.test.ts tests/conversationalFollowUp.test.ts tests/groqFallback.test.ts tests/dynamicModelSwitching.test.ts tests/mantriRegressionAndVercel.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "2.2.13",
    "groq-sdk": "^1.6.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.475.0",
    "motion": "^13.4.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
